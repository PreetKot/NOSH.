{
  "name": "nosh-dish-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "node scripts/build.js",
    "verify:clean": "node scripts/verify-clean.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test tests/api.test.js",
    "test:ui": "node --test tests/ui.test.js",
    "test:bonus": "node --test tests/sync.test.js tests/bonus.test.js",
    "test:all": "npm test && npm run test:ui && npm run test:bonus"
  },
  "devDependencies": { "playwright": "1.58.2" }
}
